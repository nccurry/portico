# Copy this file to .env before running docker compose.
# Pin an exact Portico release rather than using latest.
PORTICO_IMAGE=ghcr.io/nccurry/portico:1.3.0

# Keep the dashboard on the host by default. Use 0.0.0.0 only on a trusted LAN.
PORTICO_PUBLISH_ADDRESS=127.0.0.1
PORTICO_PUBLISH_PORT=8501

TZ=Etc/UTC

# The Discord summary is disabled unless this value is true.
PORTICO_DISCORD_ENABLED=false

# Five-field cron schedule in the TZ timezone. Default: Sunday at 9:00 AM.
PORTICO_DISCORD_CRON=0 9 * * 0
