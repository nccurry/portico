{
  "name": "Portico",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "cacheFrom": "ghcr.io/nccurry/portico-devcontainer:main"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "containerEnv": {
    "PORTICO_UV": "uv",
    "PORTICO_TASK": "task",
    "PORTICO_VENV": "/opt/portico/.venv",
    "UV_PROJECT_ENVIRONMENT": "/opt/portico/.venv",
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_DOWNLOADS": "0"
  },
  "mounts": [
    "source=portico-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Portico",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /opt/portico /home/vscode/.cache/uv && task dev:sync && task dev:verify",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/portico/.venv/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}
